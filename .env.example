# Copy to .env and edit. Never commit real secret values.
EVAL_HARNESS_ENVIRONMENT=development
EVAL_HARNESS_LOG_LEVEL=INFO
EVAL_HARNESS_ARTIFACT_ROOT=./artifacts

# Comma-separated names of environment variables that hold secrets.
# Only the names are stored in config; values are read from the environment
# at runtime and never persisted to artifacts.
# EVAL_HARNESS_SECRET_REFS=TARGET_API_KEY,JUDGE_API_KEY
